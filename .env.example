# GPU設定（デフォルト: 単一GPU対応）
# ほとんどの環境で以下のデフォルト設定で動作
# GPU_DEVICES=0
# OLLAMA_PARALLEL=1

# === 本番環境用（複数GPU搭載）===
# GPU 2枚の場合:
# GPU_DEVICES=0,1
# OLLAMA_PARALLEL=2

# GPU 4枚の場合:
# GPU_DEVICES=0,1,2,3
# OLLAMA_PARALLEL=4

# === GPU不要な環境 ===
# GPU を使わない場合は設定を削除（デフォルト値のままで OK）

# === セキュリティ関連（backend/app） ===
# 変更系エンドポイント + /chat/ + /collections/ + /documents/{name} の認証キー。
# 未設定だと認証がスキップされる（開発環境用のデフォルト）。本番では必ず設定する。
# API_KEY=

# CORS許可オリジン（カンマ区切り）
# CORS_ORIGINS=http://localhost:3000

# /chat/ から許可するコレクション名（カンマ区切り）。"all" は指定不可。
# PUBLIC_CHAT_COLLECTIONS=default

# レート制限（slowapi形式: "回数/期間"）
# RATE_LIMIT_CHAT=5/minute
# RATE_LIMIT_UPLOAD=10/minute

# アップロード上限バイト数（デフォルト10MB）
# MAX_UPLOAD_SIZE_BYTES=10485760
